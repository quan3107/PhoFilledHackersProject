# Normalize line endings to LF on checkout and commit
* text=auto eol=lf

# Binary files should not be normalized
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.mp4 binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
